# Company ID for multi-company support in accounting integration
VITE_COMPANY_ID=1

# Accounting API Base URL (defaults to inventory API URL if not set)
VITE_ACCOUNTING_API_URL=http://localhost:8001/api

# Inventory -> Accounting sales order sync
# Master kill switch
PROJECT_SYNC_DISABLED=false
# false: only never-synced POs are pushed automatically (legacy). true: every edit is pushed as a delta.
PROJECT_SYNC_ON_UPDATE=false
# Seconds to wait so a burst of edits collapses into one job (needs a real queue, not QUEUE_CONNECTION=sync)
PROJECT_SYNC_DELAY=5
PROJECT_SYNC_QUEUE=default
